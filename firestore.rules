// Ownlayer rules proposal ONLY. The live AI Engine project's rules must be merged
// with this fragment after review; NEVER replace its complete live rules blindly.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ownlayerUsers/{userId}/datasets/{datasetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /ownlayerUsers/{userId}/sources/{sourceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
